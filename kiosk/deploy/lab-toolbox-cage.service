# Cage monitor (USB webcam snapshots, missing-tool alerts). Installed and enabled by install.sh
[Unit]
Description=Lab Toolbox cage monitor
After=network.target
# Database, photos and settings live on the data partition
RequiresMountsFor=/data

[Service]
User=kiosk
# video: USB webcam access
SupplementaryGroups=video
WorkingDirectory=/opt/lab-toolbox/kiosk
EnvironmentFile=/data/lab-toolbox.env
# Below the scan screen, so a snapshot comparison never makes a checkout feel slow on the Pi 3B+
Nice=10
ExecStart=/opt/lab-toolbox/kiosk/.venv/bin/python -m lab_toolbox.cage
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
