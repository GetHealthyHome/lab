# Full-screen kiosk browser on the 7" touchscreen. Installed and enabled by install.sh
# cage is a one-window display server: Chromium fills the screen and there is no desktop to escape to.
# -s leaves Ctrl+Alt+F2 working: it shows a text login that needs the Pi password, the staff way in
# where the network blocks SSH. Ctrl+Alt+F1 returns to the kiosk.
[Unit]
Description=Lab Toolbox screen (Chromium kiosk)
After=systemd-user-sessions.service lab-toolbox-kiosk.service
Wants=lab-toolbox-kiosk.service
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=lab-toolbox-screen
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=WLR_LIBINPUT_NO_DEVICES=1
ExecStartPre=-/bin/sh -c 'echo "Lab Toolbox is starting. Staff: Ctrl+Alt+F2 to log in." >/dev/tty1'
# Wait for the web service. If it isn't up after 60 s the browser doesn't start and systemd tries again:
# the screen never opens on an error page, and the text console (password login) stays reachable to fix it
ExecStartPre=/usr/bin/timeout 60 /bin/sh -c 'until curl -sf http://127.0.0.1:8000/api/health >/dev/null; do sleep 1; done'
ExecStart=/usr/bin/cage -s -- /usr/local/bin/lab-toolbox-browser \
  --kiosk --incognito --ozone-platform=wayland \
  --noerrdialogs --disable-infobars --no-first-run --disable-session-crashed-bubble \
  --disable-pinch --overscroll-history-navigation=0 --disable-features=Translate,TouchpadOverscrollHistoryNavigation \
  --password-store=basic --check-for-update-interval=31536000 \
  http://127.0.0.1:8000/
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
