# Lives at /data/lab-toolbox.env (install.sh puts it there; chmod 600, owned by kiosk). Every service reads it.
# Edit with: sudo nano /data/lab-toolbox.env   then: sudo reboot
KIOSK_DB=/data/kiosk.db
KIOSK_ID=gate-1
GATE_CAMERA=pi
PHOTO_DIR=/data/photos
# USB webcam aimed at the shelves
CAGE_CAMERA=/dev/video0
# GPIO (BCM) pin of the buzzer; leave out for a silent kiosk
BUZZER_PIN=18
GOOGLE_KEY_FILE=/data/google-key.json
SHEET_ID=
DRIVE_FOLDER_ID=
