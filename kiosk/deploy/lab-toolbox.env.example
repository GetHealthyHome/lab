# Copy to /etc/lab-toolbox.env (chmod 600, owned by kiosk). Both services read it.
KIOSK_DB=/data/kiosk.db
KIOSK_ID=gate-1
GATE_CAMERA=pi
PHOTO_DIR=/data/photos
# GPIO (BCM) pin of the buzzer; leave out for a silent kiosk
BUZZER_PIN=18
GOOGLE_KEY_FILE=/data/google-key.json
SHEET_ID=
DRIVE_FOLDER_ID=
