# Lives at /data/lab-toolbox.env (install.sh puts it there; chmod 600, owned by kiosk). Every service reads it.
# Edit with: sudo nano /data/lab-toolbox.env   then: sudo reboot
KIOSK_DB=/data/kiosk.db
KIOSK_ID=gate-1
GATE_CAMERA=pi
PHOTO_DIR=/data/photos
# USB webcam aimed at the shelves. Two cameras: both names with a comma between, top view first, and use the
# fixed names from  ls /dev/v4l/by-id/  (the ones ending in index0), because video0 and video2 can swap at boot.
# Changing the cameras or their order means a new reference photo and new boxes on the Calibrate page.
CAGE_CAMERA=/dev/video0
# NFC reader for tool stickers (PN532 on the I2C pins); leave out to scan printed labels only
NFC_READER=pn532
# GPIO (BCM) pin of the buzzer; leave out for a silent kiosk
BUZZER_PIN=18
GOOGLE_KEY_FILE=/data/google-key.json
SHEET_ID=
DRIVE_FOLDER_ID=
