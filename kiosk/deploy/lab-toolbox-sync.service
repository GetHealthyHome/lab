# Google sync. Copy to /etc/systemd/system/, then: systemctl enable --now lab-toolbox-sync
[Unit]
Description=Lab Toolbox Google sync
After=network-online.target
Wants=network-online.target

[Service]
User=kiosk
WorkingDirectory=/opt/lab-toolbox/kiosk
EnvironmentFile=/etc/lab-toolbox.env
ExecStart=/opt/lab-toolbox/kiosk/.venv/bin/python -m lab_toolbox.sync_service
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
