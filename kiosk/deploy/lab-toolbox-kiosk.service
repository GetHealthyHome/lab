# Web service + gate camera reader. Installed and enabled by install.sh
[Unit]
Description=Lab Toolbox kiosk (API, gate camera, buzzer)
After=network.target
# Database, photos and settings live on the data partition
RequiresMountsFor=/data

[Service]
User=kiosk
# video: camera access, gpio: buzzer
SupplementaryGroups=video gpio
WorkingDirectory=/opt/lab-toolbox/kiosk
EnvironmentFile=/data/lab-toolbox.env
ExecStart=/opt/lab-toolbox/kiosk/.venv/bin/uvicorn lab_toolbox.app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
