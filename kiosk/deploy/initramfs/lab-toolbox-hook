#!/bin/sh
# initramfs hook: copies the tools lab-toolbox-split needs into the initramfs.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions
for t in e2fsck resize2fs sfdisk blkid; do copy_exec "$(command -v $t)" /sbin; done
# own name: busybox ships a mke2fs that only knows a few options and would win otherwise
copy_exec "$(command -v mke2fs)" /sbin/lab-toolbox-mke2fs
copy_file config /etc/mke2fs.conf /etc/mke2fs.conf
